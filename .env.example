# Copy to .env for local development. Every value here is a placeholder.

PORT=8080
DATABASE_URL=postgres://postgres:postgres_password@localhost:5433/todo_db?sslmode=disable

# Origin of the SPA. Also the default entry on both the Google redirect
# allowlist and the CORS allowlist, so a domain change is a variable edit.
FRONTEND_URL=http://localhost:5173
# Extra browser origins allowed to call the API, comma separated. FRONTEND_URL
# and localhost are always allowed and need not be repeated.
CORS_ALLOWED_ORIGINS=

JWT_SECRET=change-me
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=720h

# --- Google OAuth -----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Default for the popup flow. The redirect flow overrides it per request with a
# value from the allowlist below.
GOOGLE_REDIRECT_URL=postmessage
# Comma-separated, exact matches for Authorized redirect URIs in Google Cloud
# Console. FRONTEND_URL is always allowed and does not need repeating here.
GOOGLE_ALLOWED_REDIRECT_URLS=

# --- Email ------------------------------------------------------------------
# smtp | brevo | mailjet | smtp2go. Leave empty to auto-detect from whichever
# provider key is set, falling back to smtp.
# Most PaaS hosts (Railway included) block outbound SMTP ports on their cheaper
# plans, so a deploy there needs one of the HTTP providers.
EMAIL_PROVIDER=smtp
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=TaskFlow
EMAIL_TIMEOUT=15s

# EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=

# EMAIL_PROVIDER=brevo
# Note: Brevo gates transactional sending on new accounts behind manual review.
BREVO_API_KEY=

# EMAIL_PROVIDER=mailjet — needs both halves of the key pair
MAILJET_API_KEY=
MAILJET_SECRET_KEY=

# EMAIL_PROVIDER=smtp2go
SMTP2GO_API_KEY=

# --- Gemini (AI summary + sprint planning) ----------------------------------
# Leave empty to disable; the AI endpoints then return 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT=90s
GEMINI_MAX_RETRIES=2
GEMINI_TEMPERATURE=0.3

# --- Analytics export webhooks ----------------------------------------------
EXPORT_TIMEOUT=15s
EXPORT_MAX_RETRIES=2
# Only enable against a trusted network: it disables the SSRF guard.
EXPORT_ALLOW_PRIVATE_TARGETS=false
EXPORT_MAX_PAYLOAD_BYTES=8388608
